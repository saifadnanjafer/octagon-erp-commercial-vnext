# Octagon Commercial VNext - isolated local runtime only
NODE_ENV=development
PORT=8091
OCTAGON_DEFAULT_PORT=8091
OCTAGON_FALLBACK_PORTS=
OCTAGON_DB_FILE=./vnext-data/vnext.json
OCTAGON_SQLITE_DB_FILE=./vnext-data/vnext.db
USE_SQLITE=true
OCTAGON_BACKUP_DIR=./vnext-backups
OCTAGON_BACKUP_LOG=./vnext-runtime/server-backup.log
OCTAGON_CRASH_LOG=./vnext-runtime/server-crash.log
OCTAGON_REVIEW_REPORT_DIR=./vnext-review-reports
OCTAGON_UPLOAD_DIR=./vnext-uploads
OCTAGON_ATTACHMENT_DIR=./vnext-attachments
OCTAGON_PRODUCTION_ROOT=../octagon-erp
OCTAGON_PRODUCTION_DB_FILE=../octagon-erp/database.json
OCTAGON_PRODUCTION_SQLITE_DB_FILE=../octagon-erp/database.db
